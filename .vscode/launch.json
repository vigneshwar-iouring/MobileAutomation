    /*{
      // Runs through the real wdio CLI (not plain node) - New_Regression.spec.js needs
      // Mocha's describe/it and WebdriverIO's browser/driver/$ globals, both only
      // injected by an actual `wdio run` session, so it can't launch like the plain
      // node tests/*.test.js entries below. autoAttachChildProcesses is required
      // because wdio's local runner executes the spec in a spawned worker process -
      // breakpoints in the spec file or its page objects live in that child, not in
      // this launched process itself.
      "type": "node",
      "request": "launch",
      "name": "Regression Spec — Real Device",
      "program": "${workspaceFolder}/node_modules/@wdio/cli/bin/wdio.js",
      "args": [
        "run",
        "${workspaceFolder}/config/wdio.android.conf.js",
        "--spec",
        "${workspaceFolder}/Regression/New_Regression.spec.js"
      ],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "DEVICE_TYPE": "real"
      }
    }*/
